                                                                <a href="https://hertz-audio.com/product/dg-130-3/" class="product-tab-title-sub" itemprop="title">
                                                                    DG 130.3                                                                </a>
                                                                <div itemprop="content">
                                                                    Pair of dedicated 130mm grilles for the Dieci Hertz line                                                                </div>
                                                                <a href="https://hertz-audio.com/product/dg-130-3/" class="btn hz-btn-default mt-3">
                                                                    Read more                                                                </a>
