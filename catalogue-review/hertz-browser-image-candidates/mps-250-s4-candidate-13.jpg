				<div class="elementor-widget-container">
															<img width="1024" height="576" src="https://static.hertz-audio.com/media/2022/09/Hertz_MPBX_upfiring-1024x576.jpg" class="attachment-large size-large wp-image-8174" alt="" srcset="https://static.hertz-audio.com/media/2022/09/Hertz_MPBX_upfiring-1024x576.jpg 1024w, https://static.hertz-audio.com/media/2022/09/Hertz_MPBX_upfiring-300x169.jpg 300w, https://static.hertz-audio.com/media/2022/09/Hertz_MPBX_upfiring-768x432.jpg 768w, https://static.hertz-audio.com/media/2022/09/Hertz_MPBX_upfiring.jpg 1280w" sizes="(max-width: 1024px) 100vw, 1024px" />															</div>
