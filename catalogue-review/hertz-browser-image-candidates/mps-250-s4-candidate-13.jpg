				<div class="elementor-widget-container">
															<img width="1024" height="640" src="https://static.hertz-audio.com/media/2022/09/Hertz_Mille_PRO_Shallow_Box_250_3d-1024x640.jpg" class="attachment-large size-large wp-image-8177" alt="" srcset="https://static.hertz-audio.com/media/2022/09/Hertz_Mille_PRO_Shallow_Box_250_3d-1024x640.jpg 1024w, https://static.hertz-audio.com/media/2022/09/Hertz_Mille_PRO_Shallow_Box_250_3d-300x188.jpg 300w, https://static.hertz-audio.com/media/2022/09/Hertz_Mille_PRO_Shallow_Box_250_3d-768x480.jpg 768w, https://static.hertz-audio.com/media/2022/09/Hertz_Mille_PRO_Shallow_Box_250_3d.jpg 1440w" sizes="(max-width: 1024px) 100vw, 1024px" />															</div>
