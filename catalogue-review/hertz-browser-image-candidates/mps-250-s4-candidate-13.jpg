                                                    <div class="sc--separator-elements">
                                                        <div class="row">
                                                                                                                            <div class="col-md-6 col-sm-12 mb-3" itemprop="content">
                                                                    <img width="4767" height="1000" src="https://static.hertz-audio.com/media/2022/08/Hertz_air.png" class="attachment-full size-full" alt="MG 250.3" decoding="async" srcset="https://static.hertz-audio.com/media/2022/08/Hertz_air.png 4767w, https://static.hertz-audio.com/media/2022/08/Hertz_air-300x63.png 300w, https://static.hertz-audio.com/media/2022/08/Hertz_air-1024x215.png 1024w, https://static.hertz-audio.com/media/2022/08/Hertz_air-768x161.png 768w, https://static.hertz-audio.com/media/2022/08/Hertz_air-1536x322.png 1536w, https://static.hertz-audio.com/media/2022/08/Hertz_air-2048x430.png 2048w" sizes="(max-width: 4767px) 100vw, 4767px" />                                                                </div>
                                                                                                                            <div class="col-md-6 col-sm-12">
                                                                                                                                    <div class="product-tab-title-sub" itemprop="title">
                                                                        Air Innovative Route                                                                    </div>
                                                                                                                                        <div itemprop="content">
                                                                        <p><strong>Hertz R&amp;D</strong> has developed the proprietary <strong>AIR (Air Intercooling Revolution</strong>) technology, optimizing the fluid dynamics inside the voice coil inner chamber and the magnetic group to<strong> minimize the internal compression of air and maximize cooling capacity.</strong></p>
                                                                    </div>
                                                                                                                                </div>
